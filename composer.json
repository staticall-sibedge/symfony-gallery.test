{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",

        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",

        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "psr/http-message": "^2.0",

        "thecodingmachine/safe": "~3.4.0",

        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/yaml": "8.1.*",

        "symfony/monolog-bundle": "4.1.0",

        "league/flysystem-bundle": "~3.7.1",

        "semaio/request-id-bundle": "~3.0.0",

        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",

        "intervention/image": "^4.3",
        "nesbot/carbon": "^3.14",
        "gedmo/doctrine-extensions": "^3.22"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",

        "php-parallel-lint/php-parallel-lint": "~1.4.0",
        "squizlabs/php_codesniffer": "~4.0.4",
        "sirbrillig/phpcs-variable-analysis": "~3.0.0",
        "slevomat/coding-standard": "~8.31.1",
        "dealerdirect/phpcodesniffer-composer-installer": "~1.2.1",

        "symfony/maker-bundle": "^1.68",

        "phpstan/phpstan": "~2.2.9",
        "phpstan/extension-installer": "~1.4.3",
        "thecodingmachine/phpstan-safe-rule": "~1.4.7",
        "shipmonk/dead-code-detector": "~1.4.2",

        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "league/flysystem-memory": "^3.31"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Fixtures\\": "fixtures/",
            "AppTests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "code:lint": "@php ./vendor/bin/parallel-lint --no-colors --show-deprecated src/ tests/",
        "code:style": "@php ./vendor/bin/phpcs",
        "code:style:fix": "@php ./vendor/bin/phpcbf",
        "code:analyze:phpstan": "@php ./vendor/bin/phpstan --memory-limit=-1",

        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
